# Runtime-only distribution. Research/training Dockerfile remains unchanged.
FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704 AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 WILDFIRE_USE_SAMPLE=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-serving.lock .
RUN pip install --no-cache-dir --only-binary=:all: --require-hashes -r requirements-serving.lock && pip check
RUN useradd -m -u 1000 appuser && chown appuser:appuser /app
COPY --chown=appuser:appuser src/ src/
COPY --chown=appuser:appuser api/ api/
COPY --chown=appuser:appuser app/ app/
COPY --chown=appuser:appuser .streamlit/ .streamlit/
COPY --chown=appuser:appuser config.yaml .
COPY --chown=appuser:appuser models/artifact_manifest.json models/training_metadata.json \
    models/feature_cols.joblib models/lightgbm_model.joblib models/lightgbm_1d.joblib models/lightgbm_3d.joblib \
    models/platt_calibrator.joblib models/platt_calibrator_1d.joblib models/platt_calibrator_3d.joblib \
    models/logistic_regression.joblib models/logistic_calibrator.joblib models/scaler.joblib \
    models/lstm_model.pt models/lstm_calibrator.joblib models/lstm_preprocessing.joblib models/
COPY --chown=appuser:appuser data/geo/mato_grosso_ibge.geojson data/geo/
COPY --chown=appuser:appuser data/sample/features_sample.parquet data/sample/sample_metadata.json data/sample/
COPY --chown=appuser:appuser reports/model_comparison.csv reports/multi_horizon_comparison.csv reports/walk_forward_metrics.csv reports/drift_report.json reports/
COPY --chown=appuser:appuser scripts/smoke_api.py scripts/
USER appuser

FROM runtime AS api
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
    CMD curl --fail --silent http://localhost:8000/health || exit 1
CMD ["python", "-m", "uvicorn", "api.main:app", "--host=0.0.0.0", "--port=8000"]

FROM runtime AS dashboard
EXPOSE 8501
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
    CMD curl --fail --silent http://localhost:8501/_stcore/health || exit 1
CMD ["python", "-m", "streamlit", "run", "app/streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true", "--browser.gatherUsageStats=false"]
